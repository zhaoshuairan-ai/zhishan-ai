# =====================================================================
# 智膳 AI · 环境变量示例
# 复制本文件为 .env 后按需修改：  copy .env.example .env
# 注意：.env 已在 .gitignore 中，绝不要把真实密钥提交到仓库。
# 注意：注释请单独一行；不要写成 KEY=value#注释（# 后面的内容会被当成值的一部分）。
# =====================================================================

# ---------- 基础 ----------
# development / production
FLASK_ENV=development
# 生产环境必须改成随机长字符串（可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成）
SECRET_KEY=please-change-this-to-a-random-secret
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=5000
LOG_LEVEL=INFO

# ---------- 数据库与文件 ----------
# 默认保存在项目 data/ 目录；生产环境建议挂载持久化磁盘
# DATABASE_URL=sqlite:///D:/data/food_safety.db
# DATA_DIR=D:/data
# 上传图片目录（务必是可持久化的目录，不要放到临时目录）
# UPLOAD_DIR=D:/data/uploads
MAX_CONTENT_LENGTH_MB=20
IMAGE_MAX_EDGE=2200

# ---------- 跨域 ----------
# 前端开发服务器地址；生产环境同源部署可只保留自己的站点域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------- 账号 ----------
SESSION_DAYS=30

# 登录验证码（默认开启；关闭后登录不再要求验证码，不建议生产关闭）
LOGIN_CAPTCHA=1
CAPTCHA_TTL_SECONDS=300
# 仅测试环境可设为 1：接口会额外返回验证码答案，生产必须为 0
CAPTCHA_ECHO=0
SEED_DEMO_ACCOUNT=1
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123456

# ---------- OCR ----------
# auto  ：优先本地 OCR（RapidOCR）→ 视觉模型 → 演示样例
# local ：本地 RapidOCR（离线，无需 Key）
# vision：OpenAI 兼容的视觉模型（qwen-vl / glm-4v / gpt-4o 等）
# demo  ：内置样例文字（会被明确标记为演示数据）
OCR_PROVIDER=auto
OCR_TIMEOUT=45
OCR_LANG=ch

# 视觉模型（当 OCR_PROVIDER=vision 或 auto 且本地不可用时使用）
# 支持任何 OpenAI 兼容、能接收 image_url 的多模态服务：
#   阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-vl-max
#   DeepSeek  ：https://api.deepseek.com + deepseek-flash（官方多模态 Flash 模型）
#   智谱 GLM  ：https://open.bigmodel.cn/api/paas/v4 + glm-4v-plus
#   OpenAI    ：https://api.openai.com/v1 + gpt-4o-mini
OCR_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_VISION_API_KEY=
OCR_VISION_MODEL=qwen-vl-max

# ---------- 统一大语言模型（配料解读 / 食材解析 / 食谱 / 健康提示） ----------
# 只需配置下方 ASSISTANT_LLM_API_KEY（科普助手同一把 DeepSeek Key）；
# AI_* 留空或保持同值即可，所有家庭食材管家 AI 能力会自动复用助手配置。
# auto：有 Key 用大模型；无 Key 自动使用本地知识库规则模式（页面会标注）
# rule：强制规则模式
AI_PROVIDER=auto
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# 家庭食材管家食谱 Agent：auto（有 Key 用大模型，失败自动降级规则引擎）/ ai / rule
RECIPE_AGENT_MODE=auto

# 食材智能录入：auto（有 AI Key 用大模型解析小票/语音）/ rule（只走本地规则）
PANTRY_IMPORT_MODE=auto
# 可选：Tavily 联网检索保质期；未配置时使用内置常识表（会在接口中标记 builtin）
TAVILY_API_KEY=
# 商业/公开条码库：auto（有 SHOWAPI_APP_KEY 用 ShowAPI，否则 Open Food Facts）/ showapi / generic / openfoodfacts / none
BARCODE_PROVIDER=auto
# 万维易源 ShowAPI 条码查询 66-22，需在 https://www.showapi.com 购买资源包
SHOWAPI_APP_KEY=
# 自建/代理条码库：URL 用 {barcode} 占位，返回 JSON 至少包含 name
BARCODE_API_URL=
BARCODE_API_KEY=
BARCODE_API_KEY_HEADER=X-API-Key

# ---------- 每日临期通知（每天 8:00 由 scripts/pantry_daily_notify.py 触发） ----------
# SMTP 未配置时写入 data/notifications/email-*.log，并标记 simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
PANTRY_NOTIFY_EMAIL_TO=
# 企业微信 / 钉钉群机器人 Webhook（可选）
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
PANTRY_NOTIFY_LOG_DIR=
AI_TIMEOUT=50
AI_TEMPERATURE=0.2

# ---------- 食安科普助手（RAG） ----------
# retrieval：只做检索直答（答案逐字来自条目，不调用大模型）
# ai       ：在检索结果内用大模型改写，并做引用白名单 + 逐句依据校验
# auto     ：有 AI_API_KEY 就用 ai，否则 retrieval
ASSISTANT_MODE=auto
# 未直接命中时，是否让大模型在候选条目里选一条（只做路由，答案仍取自条目原文）
ASSISTANT_AI_FALLBACK=1

# 科普助手专用大模型接口（留空则复用上面的 AI_* 配置）
# 例：DeepSeek 官方接口
ASSISTANT_LLM_BASE_URL=https://api.deepseek.com
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=deepseek-chat
ASSISTANT_LLM_TIMEOUT=50
ASSISTANT_LLM_TEMPERATURE=0.2
# 知识与相近条目都答不了时，是否允许「通用大模型回答」（会明确标注未核验）
ASSISTANT_GENERAL_ANSWER=1

# ---------- 业务参数 ----------
RULESET_VERSION=2025.11
PAGE_SIZE=8
MAX_PAGE_SIZE=50

# ---------- 生产环境（可选） ----------
# 公网站点地址，仅用于报告页与二维码提示，不参与鉴权
PUBLIC_SITE_URL=
# 由 Flask 直接托管前端构建产物（单服务部署时为 1）
SERVE_FRONTEND=0
# FRONTEND_DIST=./frontend/dist
