# 前端环境变量示例
# 复制为 .env.local（或 .env）后修改：  copy .env.example .env.local

# 后端 API 前缀。
# 开发环境留空即可（默认 /api，由 Vite 代理到 http://127.0.0.1:5000）
# 生产环境若前后端同源部署（Flask 托管前端），也留空
# 若前后端分开部署（例如前端在 Vercel，后端在 Render），填写完整地址：
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api

# 是否启用 PWA（Service Worker）。生产构建默认启用；设为 false 可关闭
VITE_ENABLE_PWA=true

# 应用标题（仅用于展示）
VITE_APP_TITLE=智膳 AI

# 开发时代理目标（后端地址），一般无需修改
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000

# 高德 Web 服务 Key（天气 + 逆地理编码；留空时使用默认演示天气）
VITE_AMAP_KEY=
